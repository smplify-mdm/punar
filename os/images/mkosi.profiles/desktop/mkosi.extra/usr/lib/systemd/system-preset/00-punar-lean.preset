# Punar owns these lifecycle decisions. Package defaults must not silently
# add rootful API sockets, periodic container jobs, a second firewall owner,
# or a network-online boot barrier to a lean developer workstation.
disable podman*.service
disable podman*.socket
disable podman*.timer
disable netavark*.service
disable netavark*.socket
disable nftables.service
disable systemd-networkd-wait-online.service
disable systemd-homed*.service
disable dpkg-db-backup.timer

# Thunar can activate UDisks through D-Bus when removable-media support is
# actually used. Do not make it an unconditional graphical-session daemon.
disable udisks2.service

# The path unit is inert on installed systems because it is conditioned on
# punar.live=1. In the signed live environment it is the only automatic
# consumer of independently signed PUNAR_ANSWR media.
enable punar-installer-unattended.path

# greetd owns VT1 on a graphical product image.
disable getty@*.service
