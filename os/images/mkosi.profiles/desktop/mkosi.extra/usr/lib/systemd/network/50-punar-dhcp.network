# Punar default wired networking.
#
# WHY THIS EXISTS. The image shipped a browser, a firewall and no way to get an
# IP address: no DHCP client was enabled and no .network file existed, so a
# machine with a working NIC came up with no address and the browser opened to
# a network error. The desktop gate now boots a virtio NIC and fails canonical
# stabilized idle unless DHCP produced a default route, so this contract is
# runtime-proven instead of inferred from the file.
#
# Scope, stated plainly: this is basic wired connectivity — DHCPv4, IPv6 RA,
# and nothing else. It is NOT Milestone 12. The private relay (§33-34), network
# policy, per-project contexts and Wi-Fi are unbuilt and unclaimed.

[Match]
# Wired only. Wi-Fi needs an association step and a credential store, neither
# of which exists yet; matching it here would produce an interface that is
# configured and permanently down.
Type=ether

[Network]
DHCP=ipv4
# Accept router advertisements but do not request a DHCPv6 lease: on a network
# with no IPv6 this costs nothing, and on one with IPv6 it gets an address
# without a second stateful client.
IPv6AcceptRA=yes
# RFC 4941 temporary addresses, preferred for outbound connections — the same
# reasoning as SendHostname below, applied to the address itself: a SLAAC
# address derived from the interface identifier is a durable per-device
# identifier visible to every peer the machine talks to.
IPv6PrivacyExtensions=yes

[DHCPv4]
# Punar does not tell the network its hostname. The hostname is device
# identity, and broadcasting it to every DHCP server the machine ever touches
# is a privacy leak for a laptop that moves between networks — exactly the
# posture the privacy panel states. This is a deliberate deviation from
# systemd's default (SendHostname=yes).
SendHostname=no
UseDomains=yes
# Honor RFC 4833 timezone information when the local DHCP server provides it.
# This receives a network setting; it does not call an IP-geolocation service
# or disclose the device address to a third party. UTC remains the fallback.
UseTimezone=yes
