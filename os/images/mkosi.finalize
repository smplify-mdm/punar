#!/bin/sh
# Final release-tree assertion. mkosi executes this outside the image after
# package presets/firstboot and before UKI generation, with BUILDROOT and the
# serialized MKOSI_CONFIG available.
set -eu

# systemd-networkd's vendor [Install] Also= relationship recreates this link
# after the Punar preset disables wait-online. Normalize that exact generated
# edge after presets: Punar configures links asynchronously and never lets an
# absent interface hold the desktop boot path for 90 seconds.
WAIT_ONLINE_LINK="${BUILDROOT}/etc/systemd/system/network-online.target.wants/systemd-networkd-wait-online.service"
if [ -L "${WAIT_ONLINE_LINK}" ]; then
    unlink "${WAIT_ONLINE_LINK}"
elif [ -e "${WAIT_ONLINE_LINK}" ]; then
    echo "error: expected wait-online enablement to be a symlink: ${WAIT_ONLINE_LINK}" >&2
    exit 2
fi

# Distribution presets run after the product extra tree and intentionally own
# /etc enablements. Keep the immutable host-safety dependency at vendor level,
# then assert it as part of the reviewed enabled-unit manifest below. The
# initrd's /dev/shm mount crosses switch-root; this service remounts that live
# filesystem nosuid,nodev,noexec before the host manager completes sysinit.
SHM_WANTS_DIR="${BUILDROOT}/usr/lib/systemd/system/sysinit.target.wants"
SHM_UNIT="${BUILDROOT}/usr/lib/systemd/system/punar-shm-hardening.service"
[ -f "${SHM_UNIT}" ] || {
    echo "error: shared-memory hardening unit is missing: ${SHM_UNIT}" >&2
    exit 2
}
mkdir -p "${SHM_WANTS_DIR}"
ln -sfn ../punar-shm-hardening.service \
    "${SHM_WANTS_DIR}/punar-shm-hardening.service"

CHECKER=''
for candidate in \
    "${SRCDIR}/check-release-image.sh" \
    "${SRCDIR}/tools/check-release-image.sh" \
    "${SRCDIR}/../../tools/check-release-image.sh" \
    "${SRCDIR}/../../../tools/check-release-image.sh"; do
    if [ -x "${candidate}" ]; then
        CHECKER=${candidate}
        break
    fi
done
[ -n "${CHECKER}" ] || {
    echo 'error: check-release-image.sh is not reachable from SRCDIR' >&2
    exit 2
}

case "${ARCHITECTURE}" in
    x86-64|x86_64) manifest_name=expected-enabled-units.x86_64.txt ;;
    arm64|aarch64) manifest_name=expected-enabled-units.arm64.txt ;;
    *)
        echo "error: no release enabled-unit manifest for ${ARCHITECTURE}" >&2
        exit 2
        ;;
esac

MANIFEST=''
for candidate in \
    "${SRCDIR}/${manifest_name}" \
    "${SRCDIR}/os/images/${manifest_name}" \
    "${SRCDIR}/../${manifest_name}"; do
    if [ -f "${candidate}" ]; then
        MANIFEST=${candidate}
        break
    fi
done
[ -n "${MANIFEST}" ] || MANIFEST="${SRCDIR}/${manifest_name}"

KERNEL_COMMAND_LINE=$(python3 -c '
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    config = json.load(stream)
value = config.get("KernelCommandLine", [])
if isinstance(value, str):
    print(value)
else:
    print(" ".join(str(item) for item in value))
' "${MKOSI_CONFIG}")

# Pinned mkosi 26 builds its default initrd as a dependency, then appends every
# member placed under ARTIFACTDIR/io.mkosi.initrd before invoking ukify. Add the
# installer-only live-root units at that supported boundary. Growing a linked
# UKI's .initrd section later with objcopy is not equivalent: PE/COFF section
# allocation may remain at the old size even when objcopy exits successfully.
NORMALIZED_PROFILES=$(printf '%s' "${PROFILES:-}" | tr ',' ' ')
case " ${NORMALIZED_PROFILES} " in
    *' installer '*)
        [ -n "${ARTIFACTDIR:-}" ] || {
            echo 'error: mkosi did not expose ARTIFACTDIR for the installer build' >&2
            exit 2
        }
        CHECKER_DIR=$(dirname "${CHECKER}")
        INITRD_SOURCE="${CHECKER_DIR}/installer-initrd"
        INITRD_BUILDER="${CHECKER_DIR}/scripts/build-installer-initrd.sh"
        [ -d "${INITRD_SOURCE}" ] || {
            echo "error: installer initrd source is missing: ${INITRD_SOURCE}" >&2
            exit 2
        }
        [ -x "${INITRD_BUILDER}" ] || {
            echo "error: installer initrd builder is missing: ${INITRD_BUILDER}" >&2
            exit 2
        }
        mkdir -p "${ARTIFACTDIR}/io.mkosi.initrd"
        "${INITRD_BUILDER}" "${INITRD_SOURCE}" \
            "${ARTIFACTDIR}/io.mkosi.initrd/90-punar-live.initrd"
        ;;
esac

exec "${CHECKER}" "${BUILDROOT}" "${PROFILES:-}" \
    "${KERNEL_COMMAND_LINE}" "${MANIFEST}"
