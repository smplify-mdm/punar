#!/bin/sh
# x86_64 development-profile account. Release onboarding creates the first
# human account transactionally; this fixed user exists only for CI and demos.
set -eu

# Dev user for the greetd autologin session. Groups: wheel (admin), uucp
# (serial ports, dev debugging). Password matches the M0 root convention
# (documented dev convenience, not a secret).
#
# NOT `input` or `video`, like every account a release image creates
# (docs/design/onboarding.md section 1.7): the session takes its keyboard,
# pointer and DRM devices from logind on the active seat. This user is the
# person the desktop gates act as, so it must hold what a person holds, or a
# gate proves a device path the product does not have. surfaces-check.sh
# asserts both absences, and that /dev/input stays closed to it.
if ! getent group punar >/dev/null 2>&1; then
    groupadd --system punar
fi
useradd -m -g punar -G wheel,uucp -s /bin/bash punar
echo 'punar:punar' | chpasswd

# Rootless podman: subordinate uid/gid ranges (spec §76 M1 Podman
# deliverable; newuidmap/newgidmap ship in base's shadow).
rm -f /etc/subuid /etc/subgid
echo 'punar:100000:65536' > /etc/subuid
echo 'punar:100000:65536' > /etc/subgid
