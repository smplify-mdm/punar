# Native image builder for the pinned-Debian amd64 and arm64 migration lanes.
#
# The base is digest-pinned and apt itself is redirected to the same timestamp
# before any package is installed. HTTP is intentional for the bootstrap:
# debian:sid-slim contains no CA bundle, while apt authenticates the snapshot's
# signed Release metadata with the pinned Debian archive keyring. ca-certificates
# is then installed for mkosi's HTTPS target-image fetches.
#
# RETRIES ARE NOT OPTIONAL HERE. snapshot.debian.org is one archive serving every
# historical timestamp, and it rate-limits: a build failed on 2026-09-07 with
# `TooManyRequests 503 No healthy backends` and `504 Gateway Timeout` across nine
# gcc-16 packages, turning a docs-only commit red. apt does not retry by default,
# so a single throttled object failed the whole image. Five retries with a 60 s
# timeout cost nothing on a healthy fetch and remove the most common way this
# lane goes red for a reason unrelated to the change under test.
#
# This does NOT weaken the pin. The timestamp, the base digest and the keyring
# are untouched, so a retry can only ever re-fetch the same signed bytes.

ARG BASE_IMAGE=docker.io/debian:sid-slim
FROM ${BASE_IMAGE}

ARG SNAPSHOT_ID=20260820T000000Z

ENV DEBIAN_FRONTEND=noninteractive

RUN printf '%s\n' \
        'Types: deb' \
        "URIs: http://snapshot.debian.org/archive/debian/${SNAPSHOT_ID}/" \
        'Suites: unstable' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp' \
        > /etc/apt/sources.list.d/debian.sources \
    && printf '%s\n' \
        'Acquire::Check-Valid-Until "false";' \
        'Acquire::Retries "5";' \
        'Acquire::http::Timeout "60";' \
        > /etc/apt/apt.conf.d/99-punar-snapshot \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        mkosi \
        systemd-ukify \
        systemd-boot-efi \
        systemd-cryptsetup \
        binutils \
        qemu-utils \
        dosfstools \
        mtools \
        e2fsprogs \
        btrfs-progs \
        erofs-utils \
        xorriso \
        grub-common \
        cpio \
        zstd \
        git \
        cargo \
        rustc \
        libpam0g-dev \
        ca-certificates \
        debian-archive-keyring \
    && if [ "$(dpkg --print-architecture)" = amd64 ]; then \
        apt-get install -y --no-install-recommends grub-efi-amd64-bin; \
    fi \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
