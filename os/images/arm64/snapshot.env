# Native ARM64 migration-lane pins.
#
# Debian's snapshot service covers amd64 and arm64 with one timestamp, which
# is the property ADR-005 requires before the two production architectures can
# share a substrate. This lane remains separate from the shipping x86_64/Arch
# image until x86_64 also crosses to Debian with equivalent runtime proof.

PUNAR_DEBIAN_SNAPSHOT="20260820T000000Z"
PUNAR_DEBIAN_SOURCE_DATE_EPOCH="1787184000"
PUNAR_SNAPSHOT_PIN="20260820T000000Z"
PUNAR_BASE_IMAGE_VERSION="2026.08.20.1"
# Start behind the package snapshot, then let apt upgrade the complete builder
# from the one timestamp above. A newer sid base can contain libc versions that
# did not exist in the snapshot yet, making an otherwise pinned clean build
# unsatisfiable.
PUNAR_DEBIAN_BUILDER_BASE="docker.io/debian:stable-slim@sha256:04634311a8d5fc442b6eb06d792293c4f3e2268652ca7634e00ce8ef5cc0a28a"
