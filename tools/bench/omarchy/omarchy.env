# The Omarchy release the head-to-head measures, pinned (tools/bench/README.md).
# Changing any line here is a new comparison and needs the owner's approval
# again. The SHA-256 is Omarchy's published one (iso.omarchy.org/
# omarchy-4.0.4.iso.sha256 and the 4.0.4 release notes); the harness refuses
# an ISO that does not match it.
OMARCHY_VERSION=4.0.4
OMARCHY_ISO_URL=https://iso.omarchy.org/omarchy-4.0.4.iso
OMARCHY_ISO_SHA256=ddeded2758c48318d201dfdac905ecb28f570441883f0c052ea3cd5d05acf92d
# archinstall schema the cidata templates follow (4.0.4 ships archinstall 3.0.9).
OMARCHY_ARCHINSTALL_SCHEMA=3.0.9
