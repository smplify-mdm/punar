{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.punar.org/catalog/app-catalog.json",
  "title": "Punar application catalog",
  "description": "Signed-image application identities and their fixed install sources. Flatpak containment is computed from signed metadata; vendor Debian payloads are digest-pinned, scriptless, and launched through Punar containment.",
  "type": "object",
  "required": ["v", "catalogVersion", "generatedAt", "remotes", "apps"],
  "properties": {
    "v": {"const": 1},
    "catalogVersion": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "remotes": {
      "type": "array",
      "items": {"$ref": "#/$defs/remote"},
      "maxItems": 8
    },
    "apps": {
      "type": "array",
      "items": {"$ref": "#/$defs/app"},
      "maxItems": 160
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "remote": {
      "type": "object",
      "required": ["id", "repoFile", "url"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "repoFile": {"type": "string", "pattern": "^/usr/share/punar/catalog/remotes/[A-Za-z0-9._-]+$"},
        "url": {"type": "string", "pattern": "^https://"}
      },
      "additionalProperties": false
    },
    "disclosure": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]{0,63}$"},
        "text": {"type": "string", "minLength": 1, "maxLength": 240}
      },
      "additionalProperties": false
    },
    "flatpak": {
      "type": "object",
      "required": ["kind", "architectures", "remote", "appId", "ref", "commit", "runtime", "metadataSha256"],
      "properties": {
        "kind": {"const": "flatpak"},
        "architectures": {
          "type": "array",
          "items": {"enum": ["x86_64", "aarch64"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "remote": {"$ref": "#/$defs/id"},
        "appId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"},
        "ref": {"type": "string", "pattern": "^app/[A-Za-z0-9._-]+/(x86_64|aarch64)/[A-Za-z0-9._-]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runtime": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "metadataSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "required": ["kind", "architectures", "url", "browser"],
      "properties": {
        "kind": {"const": "web"},
        "architectures": {
          "type": "array",
          "items": {"enum": ["x86_64", "aarch64"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "url": {"type": "string", "pattern": "^https://"},
        "browser": {"const": "chromium"}
      },
      "additionalProperties": false
    },
    "vendorDeb": {
      "type": "object",
      "required": ["kind", "architectures", "url", "sha256", "byteSize", "packageName", "version", "dataMember", "payloadRoot", "executable", "iconPath", "desktopId"],
      "properties": {
        "kind": {"const": "vendor_deb"},
        "architectures": {
          "type": "array",
          "items": {"enum": ["x86_64", "aarch64"]},
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true
        },
        "url": {
          "type": "string",
          "pattern": "^https://(persistent\\.oaistatic\\.com/codex-app-prod/linux/deb/|downloads\\.claude\\.ai/claude-desktop/apt/stable/pool/main/)"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byteSize": {"type": "integer", "minimum": 1, "maximum": 629145600},
        "packageName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,79}$"},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+:~_-]{0,79}$"},
        "dataMember": {"const": "data.tar.xz"},
        "payloadRoot": {"type": "string", "pattern": "^\\./usr/lib/[A-Za-z0-9._+-]+$"},
        "executable": {"type": "string", "pattern": "^usr/lib/[A-Za-z0-9._+/-]+$"},
        "iconPath": {"type": "string", "pattern": "^\\./usr/share/(pixmaps|icons)/[A-Za-z0-9._+/-]+$"},
        "desktopId": {"type": "string", "pattern": "^punar-[a-z0-9][a-z0-9-]{0,63}$"}
      },
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "required": ["id", "name", "category", "summary", "trustTier", "license", "publisher", "bundledUpdater", "disclosures", "sources"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "icon": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.(svg|png)$"},
        "featured": {"type": "boolean"},
        "category": {"enum": ["ai", "browsers", "communication", "developer", "diagnostics", "editors", "files", "graphics", "media", "productivity", "security", "terminals", "utilities", "writing"]},
        "keywords": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[A-Za-z0-9][A-Za-z0-9 .+#_-]*$"},
          "maxItems": 16,
          "uniqueItems": true
        },
        "summary": {"type": "string", "minLength": 1, "maxLength": 240},
        "trustTier": {"enum": ["curated", "community"]},
        "license": {"enum": ["free", "mixed", "proprietary"]},
        "publisher": {"enum": ["upstream", "flathub", "third-party"]},
        "bundledUpdater": {"enum": ["none", "disabled-by-packaging"]},
        "disclosures": {
          "type": "array",
          "items": {"$ref": "#/$defs/disclosure"},
          "maxItems": 12
        },
        "sources": {
          "type": "array",
          "items": {"oneOf": [{"$ref": "#/$defs/flatpak"}, {"$ref": "#/$defs/vendorDeb"}, {"$ref": "#/$defs/web"}]},
          "minItems": 1,
          "maxItems": 4
        }
      },
      "additionalProperties": false
    }
  }
}
