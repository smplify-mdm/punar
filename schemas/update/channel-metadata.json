{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.punar.dev/v1alpha1/update/channel-metadata.json",
  "title": "Punar update channel metadata",
  "description": "Small signed channel head fetched by managed and unmanaged devices. Rollout selection happens locally and sends no device identifier.",
  "type": "object",
  "required": [
    "schema_version",
    "image_id",
    "architecture",
    "boot_platform",
    "channel",
    "current",
    "release_manifest",
    "rollout_bps",
    "halted",
    "published_at",
    "min_supported_version"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "image_id": { "$ref": "https://schemas.punar.dev/v1alpha1/update/release-manifest.json#/$defs/image_id" },
    "architecture": { "$ref": "https://schemas.punar.dev/v1alpha1/update/release-manifest.json#/$defs/architecture" },
    "boot_platform": { "$ref": "https://schemas.punar.dev/v1alpha1/update/release-manifest.json#/$defs/boot_platform" },
    "channel": { "$ref": "https://schemas.punar.dev/v1alpha1/update/release-manifest.json#/$defs/channel" },
    "current": { "$ref": "https://schemas.punar.dev/v1alpha1/update/release-manifest.json#/$defs/version" },
    "release_manifest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*release\\.json$"
    },
    "rollout_bps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "halted": { "type": "boolean" },
    "published_at": { "$ref": "https://schemas.punar.dev/v1alpha1/common/defs.json#/$defs/timestamp" },
    "min_supported_version": { "$ref": "https://schemas.punar.dev/v1alpha1/update/release-manifest.json#/$defs/version" }
  },
  "additionalProperties": false
}
