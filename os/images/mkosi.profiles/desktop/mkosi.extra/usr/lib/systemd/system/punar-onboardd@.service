# One identity transaction, one process. Instantiated by punar-onboardd.socket
# with the accepted connection already on stdin and stdout; see that unit for
# why the socket is owned by systemd rather than by this service.
#
# The sandbox is the one the resident service used, unchanged, minus Restart=:
# a per-connection process that fails has nothing to restart into, and a
# refused request is a normal outcome rather than a unit failure.
[Unit]
Description=Punar identity transaction (connection %i)
Documentation=file:/usr/share/doc/punar/onboarding-flow.md
Requires=punar-identity-materialize.service
After=punar-identity-materialize.service

[Service]
Type=simple
ExecStart=/usr/bin/punar-onboardd session
StandardInput=socket
StandardOutput=socket
StandardError=journal
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Account creation owns this one writable subtree while the rest of the image
# remains read-only. ProtectHome=read-only would remount /home above this
# allow-list and makes the real first-run transaction fail before commit.
ReadWritePaths=-/run/userdb -/run/punar -/run/punar-onboardd -/run/punar-first-login /var/lib/punar /home
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
