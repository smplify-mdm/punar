# Punar short-lived credential broker (SPEC sections 11.4, 29; M9 —
# docs/development/milestone-9.md §3.1). Serves the closed `credential.*`
# method table on /run/punar-secrets/secrets.sock (docs/api/ipc.md §16),
# reads its class catalog from /usr/share/punar/secrets/classes.yaml and
# the AI authority document from /usr/share/punar/policy/ai-defaults.yaml,
# and consults punard's approval engine for `request`-policy classes.
#
# A SEPARATE daemon from punard by decision (milestone-9.md §3.1), for four
# reasons that are all about blast radius:
#   1. punard writes /etc, shells out to nft and holds enrollment. The one
#      process that ever holds a plaintext token should share none of that.
#   2. A daemon with NO StateDirectory= and no writable path outside its own
#      socket dir and the shared audit log is the strongest PROVABLE form of
#      "never written to disk" (SPEC section 29). The hardening below is the
#      proof, not the promise.
#   3. That hardening is stricter than punard's can be — ProtectSystem=strict
#      and PrivateNetwork=yes are free here and impossible there.
#   4. A restart drops every live token harmlessly instead of coupling
#      credential lifetime to reconcile or enrollment.
#
# NOT socket-activated, deliberately (milestone-9.md §3.1): a token TTL is a
# wall-clock promise, and a broker that can be stopped would have to either
# lose the tokens it issued or persist them. Persisting them is exactly what
# section 29 forbids, so the daemon stays resident and holds them in memory.
#
# Enablement is DECLARATIVE at the VENDOR level: the extra tree ships
# usr/lib/systemd/system/multi-user.target.wants/punar-secrets.service.
# mkosi applies Arch's presets (disable *) to /etc AFTER extra trees, so
# postinst systemctl and /etc symlinks are preset-wiped — /usr/lib .wants
# only (the twice-verified M1 lesson). `systemctl is-enabled` reports
# `disabled` for a vendor-wants unit: m9-check asserts the SYMLINK plus
# `Wants=` in `systemctl show multi-user.target`, never is-enabled (the M4
# lesson).

[Unit]
Description=Punar credential broker (short-lived, mock provider)
# /run/punar-secrets comes from tmpfiles.d/punar-secrets.conf; /var/log/punar
# from tmpfiles.d/punard.conf. systemd-tmpfiles-setup orders before
# basic.target, which every default-dependency service (this one) starts
# after.
#
# Ordering ONLY — no Wants/Requires. The broker dials punard's socket for
# `request`-policy classes, but it must not drag punard into its dependency
# graph: if punard is unreachable, a `request` class fails closed with
# `upstream_unreachable` and issues NOTHING, while `allow` and `deny` classes
# still answer correctly. A broker that cannot start because punard is down
# would be a worse failure than one that refuses to escalate.
After=punard.service

[Service]
Type=simple
ExecStart=/usr/bin/punar-secrets run
Restart=on-failure
# Required by the cross-architecture stabilized-idle CPU/write gate.
CPUAccounting=yes
IOAccounting=yes
# --- hardening (milestone-9.md §3.1) --------------------------------------
# The complete writable set: the socket directory and the shared audit log
# (plus its rotation lock, which lives beside it). There is NO state
# directory and no other writable path — a token cannot be written to disk
# by a process that has nowhere to write it.
ProtectSystem=strict
ReadWritePaths=/run/punar-secrets /var/log/punar
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
UMask=0077
# No network surface of any kind. The MVP provider is a mock and the CI VM
# has no network; when a real provider lands it will need this line revisited
# in the open, which is the point of setting it now.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Deliberately NOT ProtectProc=/ProcSubset=: the broker reads
# /proc/<peer_pid>/cgroup to attribute a request to a managed agent session
# (the shared rule in punar_common::principal). Hiding other processes' /proc
# entries would silently disable attribution — the failure would look like
# "no agent", which is precisely the direction a security control must not
# fail in without saying so.
StandardOutput=journal
StandardError=journal
