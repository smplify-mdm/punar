{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.punar.dev/v1alpha1/install/plan.json",
  "title": "Punar installation plan result",
  "description": "The complete, disk-bound result of install.plan. plan_token is SHA-256 over compact recursively key-sorted JSON of the nested plan object (the jq -cS JSON bytes excluding jq's trailing newline).",
  "type": "object",
  "required": ["v", "plan", "plan_token", "hardware_report"],
  "properties": {
    "v": { "const": 1 },
    "plan": { "$ref": "#/$defs/plan" },
    "plan_token": { "$ref": "#/$defs/digest" },
    "hardware_report": {
      "$ref": "https://schemas.punar.dev/v1alpha1/install/hardware-report.json"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "device": {
      "type": "string",
      "pattern": "^/dev/[A-Za-z0-9._-]+$",
      "maxLength": 128
    },
    "plan": {
      "type": "object",
      "required": [
        "schema_version",
        "architecture",
        "boot_platform",
        "disk",
        "keymap",
        "encryption",
        "recovery_mode",
        "payload",
        "boot_artifact",
        "partitions",
        "data_subvolumes",
        "warnings"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "architecture": { "enum": ["x86_64", "aarch64"] },
        "boot_platform": { "enum": ["uefi", "raspberry_pi"] },
        "disk": { "$ref": "#/$defs/disk" },
        "keymap": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_+\\-]+$"
        },
        "encryption": { "enum": ["luks2", "none"] },
        "recovery_mode": {
          "enum": ["personal_copy", "organization_escrow", "none"]
        },
        "payload": { "$ref": "#/$defs/payload" },
        "boot_artifact": { "$ref": "#/$defs/boot_artifact" },
        "recovery_payload": { "$ref": "#/$defs/payload" },
        "recovery_boot_artifact": { "$ref": "#/$defs/boot_artifact" },
        "partitions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/partition" }
        },
        "data_subvolumes": {
          "const": ["@var", "@home", "@var-tmp"]
        },
        "warnings": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "boot_platform": { "const": "uefi" } } },
          "then": {
            "required": ["recovery_payload", "recovery_boot_artifact"],
            "properties": {
              "boot_artifact": {
                "properties": { "kind": { "const": "uki" } }
              },
              "recovery_boot_artifact": {
                "properties": { "kind": { "const": "uki" } }
              },
              "partitions": {
                "minItems": 4,
                "maxItems": 4,
                "prefixItems": [
                  {
                    "properties": {
                      "number": { "const": 1 },
                      "name": { "const": "PUNAR-ESP" },
                      "type_guid": { "const": "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" },
                      "partuuid": { "const": "8bb56554-b5f1-4058-90ac-8dc91a8e2bd4" },
                      "offset_bytes": { "const": 1048576 },
                      "size_bytes": { "const": 1073741824 },
                      "filesystem": { "const": "vfat" },
                      "encrypted": { "const": false }
                    }
                  },
                  {
                    "properties": {
                      "number": { "const": 2 },
                      "name": { "const": "PUNAR-ROOT-A" },
                      "type_guid": {
                        "enum": [
                          "4f68bce3-e8cd-4db1-96e7-fbcaf984b709",
                          "b921b045-1df0-41c3-af44-4c6f280d3fae"
                        ]
                      },
                      "partuuid": { "const": "1beabfe0-9cb8-4b49-91ef-d372b845e7ea" },
                      "offset_bytes": { "const": 1074790400 },
                      "size_bytes": { "const": 8589934592 },
                      "filesystem": { "const": "ext4" },
                      "encrypted": { "const": false }
                    }
                  },
                  {
                    "properties": {
                      "number": { "const": 3 },
                      "name": { "const": "PUNAR-ROOT-B" },
                      "type_guid": {
                        "enum": [
                          "4f68bce3-e8cd-4db1-96e7-fbcaf984b709",
                          "b921b045-1df0-41c3-af44-4c6f280d3fae"
                        ]
                      },
                      "partuuid": { "const": "2b1b91a9-cf2c-4e9c-a723-5ec997971662" },
                      "offset_bytes": { "const": 9664724992 },
                      "size_bytes": { "const": 8589934592 },
                      "filesystem": false,
                      "encrypted": { "const": false }
                    }
                  },
                  {
                    "properties": {
                      "number": { "const": 4 },
                      "name": { "const": "PUNAR-DATA" },
                      "type_guid": { "const": "0fc63daf-8483-4772-8e79-3d69d8477de4" },
                      "partuuid": { "const": "21d4af4f-a19c-4c6a-b4e8-dd50e9f7ecb9" },
                      "offset_bytes": { "const": 18254659584 },
                      "size_bytes": { "minimum": 17179869184 },
                      "filesystem": { "const": "btrfs" }
                    }
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": { "properties": { "architecture": { "const": "x86_64" } } },
                "then": {
                  "properties": {
                    "partitions": {
                      "prefixItems": [
                        {},
                        { "properties": { "type_guid": { "const": "4f68bce3-e8cd-4db1-96e7-fbcaf984b709" } } },
                        { "properties": { "type_guid": { "const": "4f68bce3-e8cd-4db1-96e7-fbcaf984b709" } } },
                        {}
                      ]
                    }
                  }
                }
              },
              {
                "if": { "properties": { "architecture": { "const": "aarch64" } } },
                "then": {
                  "properties": {
                    "partitions": {
                      "prefixItems": [
                        {},
                        { "properties": { "type_guid": { "const": "b921b045-1df0-41c3-af44-4c6f280d3fae" } } },
                        { "properties": { "type_guid": { "const": "b921b045-1df0-41c3-af44-4c6f280d3fae" } } },
                        {}
                      ]
                    }
                  }
                }
              },
              {
                "if": { "properties": { "encryption": { "const": "luks2" } } },
                "then": {
                  "properties": {
                    "partitions": {
                      "prefixItems": [{}, {}, {}, { "properties": { "encrypted": { "const": true } } }]
                    }
                  }
                }
              },
              {
                "if": { "properties": { "encryption": { "const": "none" } } },
                "then": {
                  "properties": {
                    "partitions": {
                      "prefixItems": [{}, {}, {}, { "properties": { "encrypted": { "const": false } } }]
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": { "boot_platform": { "const": "raspberry_pi" } }
          },
          "then": {
            "properties": {
              "architecture": { "const": "aarch64" },
              "boot_artifact": {
                "properties": { "kind": { "const": "raspberry_pi_bootfs" } }
              },
              "recovery_payload": false,
              "recovery_boot_artifact": false,
              "partitions": {
                "minItems": 6,
                "maxItems": 6,
                "prefixItems": [
                  {
                    "properties": {
                      "number": { "const": 1 },
                      "name": { "const": "PUNAR-SELECT" },
                      "type_guid": { "const": "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" },
                      "partuuid": { "const": "6ab88335-d069-4898-b639-734f3f2b971a" },
                      "offset_bytes": { "const": 1048576 },
                      "size_bytes": { "const": 33554432 },
                      "filesystem": { "const": "vfat" },
                      "encrypted": { "const": false }
                    }
                  },
                  {
                    "properties": {
                      "number": { "const": 2 },
                      "name": { "const": "PUNAR-BOOT-A" },
                      "type_guid": { "const": "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" },
                      "partuuid": { "const": "79115027-a3f0-43dc-a251-4a0c637b135f" },
                      "offset_bytes": { "const": 34603008 },
                      "size_bytes": { "const": 1073741824 },
                      "filesystem": { "const": "vfat" },
                      "encrypted": { "const": false }
                    }
                  },
                  {
                    "properties": {
                      "number": { "const": 3 },
                      "name": { "const": "PUNAR-ROOT-A" },
                      "type_guid": { "const": "b921b045-1df0-41c3-af44-4c6f280d3fae" },
                      "partuuid": { "const": "1beabfe0-9cb8-4b49-91ef-d372b845e7ea" },
                      "offset_bytes": { "const": 1108344832 },
                      "size_bytes": { "const": 8589934592 },
                      "filesystem": { "const": "ext4" },
                      "encrypted": { "const": false }
                    }
                  },
                  {
                    "properties": {
                      "number": { "const": 4 },
                      "name": { "const": "PUNAR-BOOT-B" },
                      "type_guid": { "const": "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" },
                      "partuuid": { "const": "706d6f54-d8b9-4276-9f4f-f1ac379a482e" },
                      "offset_bytes": { "const": 9698279424 },
                      "size_bytes": { "const": 1073741824 },
                      "filesystem": { "const": "vfat" },
                      "encrypted": { "const": false }
                    }
                  },
                  {
                    "properties": {
                      "number": { "const": 5 },
                      "name": { "const": "PUNAR-ROOT-B" },
                      "type_guid": { "const": "b921b045-1df0-41c3-af44-4c6f280d3fae" },
                      "partuuid": { "const": "2b1b91a9-cf2c-4e9c-a723-5ec997971662" },
                      "offset_bytes": { "const": 10772021248 },
                      "size_bytes": { "const": 8589934592 },
                      "filesystem": false,
                      "encrypted": { "const": false }
                    }
                  },
                  {
                    "properties": {
                      "number": { "const": 6 },
                      "name": { "const": "PUNAR-DATA" },
                      "type_guid": { "const": "0fc63daf-8483-4772-8e79-3d69d8477de4" },
                      "partuuid": { "const": "21d4af4f-a19c-4c6a-b4e8-dd50e9f7ecb9" },
                      "offset_bytes": { "const": 19361955840 },
                      "size_bytes": { "minimum": 17179869184 },
                      "filesystem": { "const": "btrfs" }
                    }
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": { "properties": { "encryption": { "const": "luks2" } } },
                "then": {
                  "properties": {
                    "partitions": {
                      "prefixItems": [{}, {}, {}, {}, {}, { "properties": { "encrypted": { "const": true } } }]
                    }
                  }
                }
              },
              {
                "if": { "properties": { "encryption": { "const": "none" } } },
                "then": {
                  "properties": {
                    "partitions": {
                      "prefixItems": [{}, {}, {}, {}, {}, { "properties": { "encrypted": { "const": false } } }]
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "disk": {
      "type": "object",
      "required": [
        "device",
        "serial",
        "size_bytes",
        "logical_sector_bytes",
        "existing_gpt_sha256"
      ],
      "properties": {
        "device": { "$ref": "#/$defs/device" },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "serial": { "type": "string", "minLength": 1, "maxLength": 256 },
        "wwn": { "type": "string", "minLength": 1, "maxLength": 256 },
        "size_bytes": { "type": "integer", "minimum": 35434546176 },
        "logical_sector_bytes": {
          "enum": [512, 4096]
        },
        "existing_gpt_sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": [
        "release_id",
        "filename",
        "digest_sha256",
        "compressed_size_bytes",
        "uncompressed_digest_sha256",
        "uncompressed_size_bytes"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "digest_sha256": {
          "allOf": [{ "$ref": "#/$defs/digest" }],
          "description": "Signed SHA-256 of the compressed release artifact."
        },
        "compressed_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Signed compressed artifact byte count."
        },
        "uncompressed_digest_sha256": {
          "allOf": [{ "$ref": "#/$defs/digest" }],
          "description": "Signed SHA-256 of the exact bytes written to and re-read from root slot A."
        },
        "uncompressed_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Signed root-slot byte count covered by uncompressed_digest_sha256."
        }
      },
      "additionalProperties": false
    },
    "boot_artifact": {
      "type": "object",
      "required": ["kind", "filename", "digest_sha256", "size_bytes"],
      "properties": {
        "kind": { "enum": ["uki", "raspberry_pi_bootfs"] },
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "digest_sha256": { "$ref": "#/$defs/digest" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "partition": {
      "type": "object",
      "required": [
        "number",
        "name",
        "type_guid",
        "partuuid",
        "offset_bytes",
        "size_bytes",
        "encrypted"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 6 },
        "name": {
          "enum": [
            "PUNAR-ESP",
            "PUNAR-SELECT",
            "PUNAR-BOOT-A",
            "PUNAR-ROOT-A",
            "PUNAR-BOOT-B",
            "PUNAR-ROOT-B",
            "PUNAR-DATA"
          ]
        },
        "type_guid": { "$ref": "#/$defs/uuid" },
        "partuuid": { "$ref": "#/$defs/uuid" },
        "offset_bytes": { "type": "integer", "minimum": 1048576 },
        "size_bytes": { "type": "integer", "minimum": 33554432 },
        "filesystem": { "enum": ["vfat", "ext4", "btrfs"] },
        "encrypted": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
