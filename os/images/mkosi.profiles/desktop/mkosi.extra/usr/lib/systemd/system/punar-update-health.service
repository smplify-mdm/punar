[Unit]
Description=Punar health gate for automatic update rollback
Documentation=https://systemd.io/AUTOMATIC_BOOT_ASSESSMENT/
ConditionPathExists=!/proc/device-tree/chosen/bootloader/partition
Requires=punard.service punar-agentd.service
After=multi-user.target graphical.target punard.service punar-agentd.service
Before=boot-complete.target

[Service]
Type=oneshot
ExecStart=/usr/lib/punar/update-health.sh
TimeoutStartSec=180
RemainAfterExit=yes
# This service never sets the clock, and privilege grants and approvals
# expire by it: ProtectClock drops CAP_SYS_TIME and refuses the
# clock-setting syscalls (why: polkit-1/rules.d/50-punar-clock.rules).
ProtectClock=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
RequiredBy=boot-complete.target
