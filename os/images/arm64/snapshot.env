# Native ARM64 migration-lane pins.
#
# Debian's snapshot service covers amd64 and arm64 with one timestamp, which
# is the property ADR-005 requires before the two production architectures can
# share a substrate. This lane is deliberately separate from the shipping
# x86_64/Arch image until the complete desktop has crossed with runtime proof.

PUNAR_DEBIAN_SNAPSHOT="20260820T000000Z"
PUNAR_DEBIAN_SOURCE_DATE_EPOCH="1787184000"
PUNAR_DEBIAN_BUILDER_BASE="docker.io/debian:sid-slim@sha256:17d1843dae9ca66f1617c1e464f40d06059ccefb0c606e8b54687f253af1684e"
