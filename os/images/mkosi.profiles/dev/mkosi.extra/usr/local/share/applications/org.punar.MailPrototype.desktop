# The dev-only fixture launcher. Its FILE ID must differ from the product's
# (org.punar.Mail.desktop): the dev profile overlays the desktop profile at
# the same paths, so an entry named org.punar.Mail.desktop here REPLACED the
# product entry in every dev image — Mail vanished from the launcher
# (NoDisplay) and the bar called the real window a prototype. The window it
# launches still announces org.punar.Mail and resolves to the product entry;
# its own masthead discloses the fixture state.
[Desktop Entry]
Type=Application
Version=1.5
Name=Mail interface prototype
GenericName=Non-functional interface prototype
Comment=Layout test with sample messages; no account or mail service is connected
Exec=/usr/lib/punar/punar-mail.sh %u
TryExec=/usr/lib/punar/punar-mail.sh
Icon=punar-mail
Terminal=false
StartupNotify=true
StartupWMClass=org.punar.Mail
NoDisplay=true
Categories=Development;
Keywords=prototype;layout;mail;
X-Punar-Product-Name=Mail interface prototype
