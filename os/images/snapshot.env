# Single source of truth for the Punar image input pins (ADR-001:
# vendor-pinned snapshot channels).
#
# PUNAR_SNAPSHOT_DATE selects an Arch Linux Archive date snapshot
# (https://archive.archlinux.org/repos/<date>/). INTERIM: ADR-001 commits to a
# Smplify-owned rsync'd mirror seeded from these snapshots; until that mirror
# exists, CI pulls the ALA snapshot directly. This is a build-input pin, not a
# user-facing mirror — no user machine ever points here.
#
# PUNAR_BUILDER_BASE pins the builder container base image by digest
# (docker.io/archlinux/archlinux:latest resolved on 2026-08-24).
#
# This file is sourced by bash (tools/build-image.sh,
# os/images/scripts/container-build.sh). Keep it to plain VAR=value lines.

PUNAR_SNAPSHOT_DATE="2026/08/20"
PUNAR_SNAPSHOT_PIN="20260820T000000Z"
# Canonical identity of the installable base image. Release publication may
# restamp a derived slot payload to its signed release version, but an image
# must already have a parseable identity before its first update check.
PUNAR_BASE_IMAGE_VERSION="2026.08.20.1"
PUNAR_BUILDER_BASE="docker.io/archlinux/archlinux@sha256:e5bfcd41ddf6190dc3fdafe0d2979b039a82f006b1666a3d207e80c9e70a00d9"
