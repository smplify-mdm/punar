# Punar scheduled reconcile (milestone-4.md §6): one full section-42 pass
# (observe → … → apply → verify → audit → compliance), driven by
# punard-reconcile.timer. Deliberately a plain root `punarctl` through the
# normal socket — the timer REUSES the audited request surface instead of an
# internal daemon thread (which would be an always-on wakeup source, invisible
# to systemctl list-timers, and an unaudited trigger path). Honest limit
# (ipc.md section 6): the daemon sees only peer credentials, so these runs
# audit as user_id "root", source "human" — indistinguishable from an admin.
#
# No User= — reconcile is root-only (ipc.md 5.6). Not [Install]-enabled
# itself; the .timer carries the vendor-wants symlink.

[Unit]
Description=Punar scheduled reconcile (drift remediation)
After=punard.service

[Service]
Type=oneshot
Slice=punar-background.slice
# Quiet: one journal line when a pass remediated something or failed to,
# nothing when it only confirmed what was already so. The full report every
# two minutes was most of the journal's idle writes and said nothing new:
# every pass is audited in /var/log/punar/audit.jsonl (a `reconcile` event,
# one per remediation attempt, one per compliance change and each enrollment
# transition; docs/api/ipc.md section 6), and `punarctl reconcile` shows the
# full report on demand.
ExecStart=/usr/bin/punarctl reconcile --quiet
# This service never sets the clock, and privilege grants and approvals
# expire by it: ProtectClock drops CAP_SYS_TIME and refuses the
# clock-setting syscalls (why: polkit-1/rules.d/50-punar-clock.rules).
ProtectClock=yes
StandardOutput=journal
StandardError=journal
# What it does write, it writes at notice, and nothing below notice is kept:
# systemd's own info lines for every run ("Starting", "Deactivated
# successfully", "Finished") go, while a failed run's lines (notice, warning,
# error) and this unit's own output stay. Measured on systemd 261. The
# kernel audit records systemd emits for each start and stop are not log
# lines and are untouched.
SyslogLevel=notice
LogLevelMax=notice
