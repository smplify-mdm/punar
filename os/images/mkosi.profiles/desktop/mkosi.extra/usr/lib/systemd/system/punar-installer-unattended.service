[Unit]
Description=Consume signed Punar unattended-install authorization
Documentation=file:/usr/share/doc/punar/installer.md
ConditionKernelCommandLine=punar.live=1
Requires=punard.service
After=punard.service systemd-udevd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/punarctl install unattended
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
PrivateMounts=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/punar
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_SYS_ADMIN
# This service never sets the clock, and privilege grants and approvals
# expire by it: ProtectClock drops CAP_SYS_TIME and refuses the
# clock-setting syscalls (why: polkit-1/rules.d/50-punar-clock.rules).
ProtectClock=yes
StandardOutput=journal
StandardError=journal
