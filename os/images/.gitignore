# Build outputs and mkosi working directories (see also repo-root .gitignore).
out/
cache/
mkosi.builddir/
mkosi.output/

# Desktop-profile content staged at build time by scripts/container-build.sh
# from its source-of-truth trees (os/modules/desktop, shell/, and since M3
# the compiled workspace binaries) — never commit; the versioned parts of
# mkosi.extra (greetd, usr/lib/punar, systemd units, tmpfiles,
# usr/share/punar/nftables) live outside these paths.
mkosi.profiles/desktop/mkosi.extra/etc/xdg/
mkosi.profiles/desktop/mkosi.extra/usr/lib/punar/punar-layout.sh
mkosi.profiles/desktop/mkosi.extra/etc/fonts/
mkosi.profiles/desktop/mkosi.extra/usr/share/fonts/
mkosi.profiles/desktop/mkosi.extra/usr/share/punar/shell/
mkosi.profiles/desktop/mkosi.extra/usr/share/punar/theme/
mkosi.profiles/desktop/mkosi.extra/usr/share/punar/fixtures/
mkosi.profiles/desktop/mkosi.extra/usr/bin/
# M6: the punar-env-base OCI archive + digest note, assembled from the pinned
# snapshot's busybox by scripts/container-build.sh (stage_env_base_oci) on
# every build — never commit (milestone-6.md §6.2).
mkosi.profiles/desktop/mkosi.extra/usr/share/punar/oci/
# M8: the comm -> process-class table, staged from crates/punar-agentd/data
# by scripts/container-build.sh — the daemon compiles the same file in as
# its fallback, so a committed second copy could drift (milestone-8.md §3.2).
mkosi.profiles/desktop/mkosi.extra/usr/share/punar/agents/process-classes.json
# M9: the AI authority document and the credential class catalog, staged
# from fixtures/policies and crates/punar-secrets/share by
# scripts/container-build.sh — both are compiled into their daemons with
# include_str!, so a committed second copy could drift (milestone-9.md
# §5.2, §6.1).
mkosi.profiles/desktop/mkosi.extra/usr/share/punar/policy/
mkosi.profiles/desktop/mkosi.extra/usr/share/punar/secrets/
