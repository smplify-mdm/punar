# Native ARM64 compatibility adapter for the shared Debian pins.
#
# Existing ARM tools source this path. Keep that interface while moving the
# actual timestamp and version pins to one architecture-neutral file.

_PUNAR_ARM64_SNAPSHOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../debian-snapshot.env
. "${_PUNAR_ARM64_SNAPSHOT_DIR}/../debian-snapshot.env"
unset _PUNAR_ARM64_SNAPSHOT_DIR

PUNAR_DEBIAN_BUILDER_BASE="${PUNAR_DEBIAN_BUILDER_BASE_ARM64}"
