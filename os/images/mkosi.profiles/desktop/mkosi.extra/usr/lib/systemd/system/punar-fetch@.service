# One download, one unprivileged process (crates/punard/src/fetch.rs).
# Instantiated by punar-fetch.socket with punard's connection on stdin.
#
# The helper is the only Punar program that runs the downloader, and this is
# what it has: a dynamic user that exists only while it runs; no capabilities
# and no way to gain any; a read-only file system with no /home, and nothing
# of /var or /run but a private tmp and the resolver's files; no devices;
# IPv4 and IPv6 sockets only, to public addresses only. The one thing it can
# write is the pipe punard sent. punard copies what arrives into a private
# file the helper never holds, bounds it, and verifies it afterwards.
#
# Measured under systemd 257 (Debian trixie) with the shipped helper: the
# exposure `systemd-analyze security punar-fetch@x.service` reports is 1.1;
# DNS through the stub, TLS and a real transfer over the pipe work; a
# redirect is refused; 127.0.0.1, 169.254.169.254 and a private-network
# address never connect (that address answers outside the sandbox, and inside
# it only once the drop-in below allows it); a proxy works through that
# drop-in; and inside the sandbox /var holds only a private tmp, /run only
# systemd/resolve, /etc/machine-id, /home and /root are unreadable and an
# AF_UNIX socket cannot be created.
#
# check-release-image.sh A19 fails a release tree in which any other unit or
# Punar program runs the downloader, in which this unit loses DynamicUser=,
# its empty capability sets, ProtectSystem=strict, its address families or
# any of its address denials, allows any address but the DNS stub, or in
# which anything else (a drop-in, an override, a top-level service.d)
# changes it.
[Unit]
Description=Punar unprivileged download (connection %i)
Documentation=file:/usr/share/doc/punar/ipc.md
CollectMode=inactive-or-failed

[Service]
Type=simple
ExecStart=/usr/lib/punar/punar-fetch
StandardInput=socket
StandardOutput=journal
StandardError=journal
# The longest transfer a request may ask for is an hour (MAX_FETCH_SECONDS);
# this is the outer bound on the whole instance.
RuntimeMaxSec=3700

DynamicUser=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
UMask=0077

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
# Nothing under /var or /run is the helper's business: account records, device
# state and every other service's runtime files stay out of reach, and so does
# the machine identifier. /run/systemd/resolve stays, because /etc/resolv.conf
# points into it.
TemporaryFileSystem=/var:ro /run:ro
BindReadOnlyPaths=-/run/systemd/resolve
InaccessiblePaths=-/etc/machine-id

# Network: IPv4 and IPv6 only. No AF_UNIX, so neither D-Bus nor any local
# service socket can be reached; name lookups fall back from nss-resolve to
# the resolver stub at 127.0.0.53, the one address below that is allowed.
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressAllow=127.0.0.53
# Everything that is not a public address is dropped by the kernel, whatever
# the downloader is made to try: loopback, link-local (and with it the
# cloud metadata address 169.254.169.254), multicast, the private networks,
# carrier-grade NAT, the unique-local IPv6 range (and with it the IPv6
# metadata address fd00:ec2::254), and the reserved, benchmarking and
# documentation ranges. A server that answers a download cannot turn the
# helper into a probe of the local network.
#
# An organization that serves updates from its own network, or requires a
# proxy, allows exactly that address in a drop-in, and the proxy through the
# service manager's environment (docs/api/ipc.md, "Download helper"):
#   [Service]
#   IPAddressAllow=10.1.2.3
IPAddressDeny=localhost link-local multicast
IPAddressDeny=0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.88.99.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 240.0.0.0/4
IPAddressDeny=::/128 ::ffff:0:0/96 100::/64 2001:db8::/32 fc00::/7 fec0::/10
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
DevicePolicy=closed
KeyringMode=private
