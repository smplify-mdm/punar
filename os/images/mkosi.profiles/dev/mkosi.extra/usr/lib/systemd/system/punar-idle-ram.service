# Canonical idle-RAM measurement + CI artifact export (milestone-1.md §8–§9,
# method fixed by PERFORMANCE_BUDGETS.md §2.1–2.2). Started by
# punar-desktop-marker.service after PUNAR_DESKTOP_OK; emits
# PUNAR_RAM_MEAN_MB / PUNAR_RAM_MAX_MB to the serial console and streams the
# /run/punar artifacts out over the punar.export virtio-serial channel.
#
# Not enabled; started explicitly by the marker service.

[Unit]
Description=Punar idle-RAM measurement and artifact export

[Service]
Type=oneshot
# 10 min stabilize + 5 min sampling + the synchronous surface-cost exercise
# (punar-surface-cost-check.service, bounded at 45 min so the 6 x 3 isolated
# Quickshell samples complete under AArch64 TCG) + the synchronous M2 exercise
# (punar-m2-check.service, itself bounded at 25 min — started by
# idle-ram.sh between sampling and export, milestone-2.md §7) + the
# synchronous M3 exercise (punar-m3-check.service, bounded at 10 min —
# milestone-3.md §8) + the synchronous M4 exercise (punar-m4-check.service,
# bounded at 12 min; its drift demo waits on wall-clock timer firings —
# milestone-4.md §10) + the synchronous M5 exercise
# (punar-m5-check.service, bounded at 15 min — milestone-5.md §10) + the
# synchronous M6 exercise (punar-m6-check.service, bounded at 10 min —
# milestone-6.md §10) plus the M7..M10 exercises and export. The individual
# child units retain their own tighter ceilings. The earlier 110-minute parent
# bound predated the 18-sample ARM/TCG surface instrument; 150 minutes keeps
# the parent from truncating a healthy sequence while the host gate retains
# its independent deadline.
TimeoutStartSec=150min
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/usr/lib/punar/idle-ram.sh
