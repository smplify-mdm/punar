# Shared Debian build-input pins for every production architecture.
#
# One timestamp is the core ADR-005 contract: package versions for amd64 and
# arm64 come from the same authenticated Debian sid snapshot. Builder bases
# are architecture-specific image manifests, pinned independently by digest.

PUNAR_DEBIAN_SNAPSHOT="20260820T000000Z"
PUNAR_DEBIAN_SOURCE_DATE_EPOCH="1787184000"
PUNAR_SNAPSHOT_PIN="20260820T000000Z"
PUNAR_BASE_IMAGE_VERSION="2026.08.20.1"

# Start behind the package snapshot, then let apt upgrade the complete builder
# from the immutable timestamp above. A newer sid base can contain libc
# versions absent from that snapshot and make a clean pinned build impossible.
PUNAR_DEBIAN_BUILDER_BASE_AMD64="docker.io/debian:stable-slim@sha256:953e69bf5f91ae4cec5539feb02b11a46f88a2bd638211fb1680c6a2d35604b4"
PUNAR_DEBIAN_BUILDER_BASE_ARM64="docker.io/debian:stable-slim@sha256:04634311a8d5fc442b6eb06d792293c4f3e2268652ca7634e00ce8ef5cc0a28a"
