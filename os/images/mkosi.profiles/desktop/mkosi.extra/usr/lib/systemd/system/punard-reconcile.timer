# Punar drift trigger (milestone-4.md §6; SPEC sections 42/43). Fires the
# oneshot punard-reconcile.service every 2 minutes so firewall/hostname/
# timezone drift is observed and remediated without any resident poll loop —
# punard itself stays zero-wakeup (spec 6.3: each firing is one short-lived
# punarctl doing three reads and at most one nft spawn, then full idle).
# AccuracySec=15 bounds firing jitter so the m4-check drift demo's
# "≤ 3 periods" window (375 s) is a testable bound, not a sloppy one.
#
# Enabled statically via multi-user.target.wants (extra-tree symlink, vendor
# level: mkosi applies distro presets to /etc enablements after extra trees —
# the M1 lesson; repo precedent punar-desktop-diag.timer).

[Unit]
Description=Punar scheduled reconcile trigger (drift remediation)
# Every reconcile pass, the enrolled device's liveness and unit checks
# included, comes from this timer: an administrator's `systemctl stop` is
# refused. Stopping it anyway (mask, a drop-in, a target that stops it)
# leaves a gap in the passes, audited as `enroll.gap` when they resume, and
# a mask or drop-in is also caught by the unit check
# (docs/development/smplify-enrollment.md section 3.4). The development
# image's exercises lift this with a drop-in of their own
# (punard-reconcile.timer.d/10-dev-stoppable.conf), which release check A5
# keeps off every release image.
RefuseManualStop=yes

[Timer]
OnBootSec=120
OnUnitActiveSec=120
AccuracySec=15

[Install]
WantedBy=multi-user.target
