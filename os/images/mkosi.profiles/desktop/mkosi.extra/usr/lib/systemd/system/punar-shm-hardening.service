[Unit]
Description=Harden the shared-memory mount
Documentation=file:/usr/share/doc/punar/security.md
DefaultDependencies=no
After=systemd-remount-fs.service
Before=sysinit.target
ConditionPathIsMountPoint=/dev/shm

[Service]
Type=oneshot
ExecStart=/usr/bin/mount -o remount,rw,nosuid,nodev,noexec,mode=1777 /dev/shm
# This service never sets the clock, and privilege grants and approvals
# expire by it: ProtectClock drops CAP_SYS_TIME and refuses the
# clock-setting syscalls (why: polkit-1/rules.d/50-punar-clock.rules).
ProtectClock=yes

[Install]
WantedBy=sysinit.target
