#!/bin/sh
# punar-mock-agent — the dev/CI stand-in for a managed AI agent session
# (docs/development/milestone-7.md section 6).
#
# There is no real AI agent binary in the CI VM (it has no network), so
# `punar-env agent <name>` substitutes this script for the adapter's real
# command when PUNAR_AGENT_MOCK=1 is set. It is deliberately a script and
# not a crate: no build surface, shellcheck-gated like every other Punar
# script, and its entire behavior fits on one screen — the honesty
# property wanted from a thing whose only job is to be obviously fake.
#
# Behavior: print the label, prove workspace access with one touch, then
# block until signaled. The block is `wait` on a background sleep — a
# blocking wait, never a polling loop (SPEC section 6.3).
#
# M8 addition (milestone-8.md section 12): PUNAR_MOCK_AGENT_CHILDREN=1 —
# unset by default, set ONLY by m8-check.sh — additionally spawns a fixed,
# deterministic set of child processes inside the session's own cgroup so
# the AI Access Ledger has real Level-3 and Level-4 evidence to derive from.
# This is a CI stand-in and says so: a real agent's children arise from real
# work, and Punar samples whatever is there. What the ledger records here is
# derived from the same two mediation points as in production — the scope
# cgroup and the audit stream — never from anything this script declares
# about itself.
#
# M12 addition: PUNAR_MOCK_AGENT_NET=1 is another dev/CI-only evidence
# switch. The script blocks on a pre-created FIFO until the check has proved
# that punar-netd attached this cgroup, then a Bash child holds one allowed
# loopback TCP connection open and records the exit/time of an identical
# denied probe. The addresses and port are fixed test fixtures; no product
# behavior reads this result file.
#
# ADR-004 addition: PUNAR_MOCK_AGENT_ISOLATION=1 records hostile filesystem
# probes from *inside* the actual managed namespace. It is enabled only by the
# M7 image gate; production adapters never receive this variable.

set -u

LABEL="PUNAR MOCK AGENT — dev/CI stand-in for a managed AI agent session; performs no AI work"
TOUCH_FILE=".punar-agent-touch"
FIFO=".punar-agent-fifo"

if [ "${1:-}" = "--version" ]; then
    echo "punar-mock-agent 0.0-mock"
    exit 0
fi

echo "$LABEL"
echo "Working directory: $(pwd)"

if touch "./$TOUCH_FILE" 2>/dev/null; then
    echo "Workspace write: ./$TOUCH_FILE"
else
    echo "Workspace write: refused (./$TOUCH_FILE not writable)" >&2
fi

if [ "${PUNAR_MOCK_AGENT_ISOLATION:-0}" = "1" ]; then
    ISOLATION_RESULTS=".punar-agent-isolation-results"
    {
        [ ! -e /run/punar-agentd/agentd.sock ] && echo "agentd_socket=absent" \
            || echo "agentd_socket=EXPOSED"
        [ ! -e /run/punar-netd/netd.sock ] && echo "netd_socket=absent" \
            || echo "netd_socket=EXPOSED"
        [ ! -e /run/punard/punard.sock ] && echo "punard_socket=absent" \
            || echo "punard_socket=EXPOSED"
        [ ! -e /run/punar-secrets/secrets.sock ] && echo "secrets_socket=absent" \
            || echo "secrets_socket=EXPOSED"
        [ ! -e "${XDG_RUNTIME_DIR}/bus" ] && echo "dbus_socket=absent" \
            || echo "dbus_socket=EXPOSED"
        [ ! -e "${HOME}/.ssh/m7-host-secret" ] && echo "real_ssh=absent" \
            || echo "real_ssh=EXPOSED"
        [ ! -e /home/punar/other-project/m7-secret ] && echo "other_project=absent" \
            || echo "other_project=EXPOSED"
        if awk '$5 == "/usr" && $6 ~ /(^|,)ro(,|$)/ { found=1 } END { exit !found }' \
                /proc/self/mountinfo; then
            echo "usr_mount=read_only"
        else
            echo "usr_mount=NOT_READ_ONLY"
        fi
        [ "$(uname -n)" = "punar-agent" ] && echo "uts=isolated" \
            || echo "uts=NOT_ISOLATED"
        [ "$(cat /proc/1/comm 2>/dev/null)" != "systemd" ] && echo "pid=isolated" \
            || echo "pid=NOT_ISOLATED"
    } > "./${ISOLATION_RESULTS}"
    echo "Isolation: hostile probe results written to ./${ISOLATION_RESULTS}"
fi

# Deterministic child processes for the M8 ledger exercise. Opt-in only.
#
# The classes chosen are the ones this image can honestly supply: `sh` and
# `git` are installed, `node` and `cargo` are NOT and are not faked
# (milestone-8.md section 12). Nothing here is a busy loop: every child
# blocks in read(2) on a fifo, which is a blocking wait (SPEC section 6.3).
#
# Why a fifo: opening a fifo for reading blocks until a writer opens it, so
# the writer is started FIRST and never writes and never exits; the readers
# then open successfully and block forever in read. That gives two
# long-lived children whose `comm` the scope-cgroup sampler can classify at
# a scan point — which is the honest thing the ledger can see (a sampled
# class, never a spawn history).
if [ "${PUNAR_MOCK_AGENT_CHILDREN:-0}" = "1" ]; then
    echo "Children: PUNAR_MOCK_AGENT_CHILDREN=1 (dev/CI evidence generation)"
    rm -f "./$FIFO"
    if mkfifo -m 600 "./$FIFO" 2>/dev/null; then
        # The writer: opens the fifo, writes nothing, exits never.
        sleep infinity > "./$FIFO" &
        # Class `shell`: blocks reading the fifo. If /bin/sh resolves
        # through a symlink the kernel may report comm=bash — both spell
        # the same CLASS in the ledger's table, which is why every M8
        # assertion is on the class and never on comm.
        /bin/sh < "./$FIFO" &
        # Class `git`: `--stdin-paths` blocks on stdin and needs no
        # repository — no repository is created here and .git/config is
        # never read. Punar does not mediate git and the ledger records
        # the PROJECT NAME from the workspace grant, never a remote URL.
        git hash-object --stdin-paths < "./$FIFO" &
        echo "Children: shell + git blocked on ./$FIFO (long-lived, sampled at scan points)"
    else
        echo "Children: could not create ./$FIFO — no process-class evidence generated" >&2
    fi
    # Older M8 fixtures called punard directly from the agent namespace here.
    # ADR-004 intentionally removes that broad control socket until a
    # session-aware mediation contract exists. Do not turn a connect failure
    # into fake approval/denial evidence: report the missing producer plainly.
    #
    # M9 changed what the FIRST one proves, and the label says so rather than
    # keeping the old sentence. Before M9 an agent's capability mutation was
    # denied outright; now the personal AI authority document says
    # `firewall: approval_required`, so punard raises an approval and answers
    # `approval_required` (exit 4). Nothing is applied either way — that is
    # the invariant this line demonstrates — but "denied" would now be the
    # wrong word for it.
    if [ ! -S /run/punard/punard.sock ]; then
        echo "Children: punard mediation unavailable — control socket intentionally absent under ADR-004"
    elif punarctl capabilities set security.firewall enabled >/dev/null 2>&1; then
        echo "Children: capabilities.set was ALLOWED — expected an approval gate from an agent peer" >&2
    else
        echo "Children: capabilities.set gated by punard (approval required, nothing applied)"
    fi
    # The Level-4 denied_access evidence, post-M9: an AI agent asking for a
    # PRIVILEGE WINDOW is refused outright and always will be. Agents get one
    # approved call at a time; a time window is a human affordance (SPEC
    # sections 48, 60). A refusal that policy can never turn into a yes is
    # the right shape for a fixture that must stay a denial.
    if [ ! -S /run/punard/punard.sock ]; then
        echo "Children: privilege evidence unavailable — direct punard access is intentionally absent"
    elif punarctl privilege request --capability security.firewall \
            --reason "mock agent asks for a privilege window" >/dev/null 2>&1; then
        echo "Children: privilege.request was ALLOWED for an agent — a grant must never be issued to an AI" >&2
    else
        echo "Children: privilege.request refused for an AI agent (the Level-4 evidence)"
    fi
fi

# Real loopback network evidence for the M12 in-VM gate. Opt-in only; the
# production adapter never sets this variable and the two listener addresses
# exist only in the dev image's zone-membership overlay.
if [ "${PUNAR_MOCK_AGENT_NET:-0}" = "1" ]; then
    NET_FIFO=".punar-agent-net-go"
    echo "Network: PUNAR_MOCK_AGENT_NET=1 (dev/CI loopback evidence generation)"
    if [ ! -p "./$NET_FIFO" ]; then
        echo "Network: required coordination FIFO ./$NET_FIFO is absent" >&2
        exit 70
    fi
    # A blocking read is the synchronization primitive: no polling and no
    # chance for the probe to race ahead of cgroup policy attachment.
    IFS= read -r _net_signal < "./$NET_FIFO"
    /bin/bash -c '
        umask 077
        result=.punar-agent-net-results
        ready=.punar-agent-net-ready
        tmp="${result}.tmp.$$"
        allow_code=0
        exec 9<>/dev/tcp/127.0.0.9/9418 || allow_code=$?
        deny_start=$(date +%s%N)
        deny_code=0
        timeout 2 /bin/bash -c "exec 8<>/dev/tcp/127.0.0.7/9418" \
            >/dev/null 2>&1 || deny_code=$?
        deny_end=$(date +%s%N)
        deny_ms=$(( (deny_end - deny_start) / 1000000 ))
        {
            printf "allow_code=%s\n" "$allow_code"
            printf "deny_code=%s\n" "$deny_code"
            printf "deny_ms=%s\n" "$deny_ms"
            printf "allow_destination=127.0.0.9\n"
            printf "deny_destination=127.0.0.7\n"
        } > "$tmp"
        mv -f "$tmp" "$result"
        : > "$ready"
        if [ "$allow_code" -eq 0 ]; then
            # fd 9 is inherited, keeping the ESTABLISHED socket observable.
            sleep infinity &
            wait $!
        fi
        exit "$allow_code"
    ' &
fi

echo "Waiting for SIGTERM/SIGINT — end this session with: systemctl --user stop <scope>"

trap 'exit 0' TERM INT
sleep infinity &
wait $!
