[Unit]
Description=Free the unpacked initramfs before switching root
DefaultDependencies=no
# Only ever in the initrd. The helper checks again that / is the initramfs.
ConditionPathExists=/etc/initrd-release
# initrd-cleanup.service has isolated initrd-switch-root.target, and every unit
# that target waits for (the udev database cleanup among them) has finished.
# Only the switch-root call itself runs after this.
After=initrd-switch-root.target initrd-cleanup.service initrd-udevadm-cleanup-db.service
Before=initrd-switch-root.service

[Service]
Type=oneshot
# Freeing memory must never cost a boot: a failure here is ignored, and the
# helper keeps everything whenever anything is not as expected.
ExecStart=-/usr/lib/punar/release-initramfs
# PID 1 keeps /usr read-only in the initrd. The helper makes it writable only
# inside this unit's own mount namespace, and refuses to without one.
PrivateMounts=yes
# kmsg is the journal and the kernel log buffer both.
StandardOutput=kmsg
StandardError=kmsg
SyslogIdentifier=punar-release-initramfs
TimeoutStartSec=30s
