# Debian/amd64 candidate adapter. The timestamp and product version are shared
# with ARM64; only the architecture-specific builder manifest differs.

_PUNAR_AMD64_SNAPSHOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../debian-snapshot.env
. "${_PUNAR_AMD64_SNAPSHOT_DIR}/../debian-snapshot.env"
unset _PUNAR_AMD64_SNAPSHOT_DIR

PUNAR_DEBIAN_BUILDER_BASE="${PUNAR_DEBIAN_BUILDER_BASE_AMD64}"
