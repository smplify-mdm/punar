#!/bin/sh
# Product-only x86_64 desktop finalization. Account creation and autologin are
# deliberately absent; the release-image assertion enforces that boundary.
set -eu

# Stable admission group shared by every human account, regardless of the
# username chosen in onboarding. It exists before tmpfiles and daemons run.
if ! getent group punar >/dev/null 2>&1; then
    groupadd --system punar
fi

# The package normally owns this locked account. Keep the product adapter
# explicit so every substrate gives greetd the same non-login identity and
# the onboarding socket can enforce its SO_PEERCRED allowlist.
if ! getent group greeter >/dev/null 2>&1; then
    groupadd --system greeter
fi
if ! getent passwd greeter >/dev/null 2>&1; then
    useradd --system --gid greeter --home-dir /var/lib/greetd \
        --no-create-home --shell /usr/bin/nologin greeter
fi
install -d -m 0750 -o greeter -g greeter /var/lib/greetd

# Configure Flathub from the image-pinned descriptor and signing key without
# fetching any app/runtime. App bytes remain on-demand under shared /var so an
# A/B OS swap neither duplicates nor loses them.
flatpak remote-add --system --if-not-exists --from flathub \
    /usr/share/punar/catalog/remotes/flathub.flatpakrepo

# Rootless-container subordinate ids are generated from the /var identity
# record at each boot. Relative links keep /etc on the replaceable root slot
# free of account authority while preserving the conventional libc/Podman API.
ln -sfn ../run/punar/subuid /etc/subuid
ln -sfn ../run/punar/subgid /etc/subgid

# A counted systemd-boot entry may be blessed only after all four Punar health
# signals pass. Use a vendor dependency rather than /etc enablement because
# the replaceable slot owns this contract and distribution presets may rewrite
# /etc after ExtraTrees are applied.
install -d -m 0755 /usr/lib/systemd/system/boot-complete.target.requires
ln -sfn ../punar-update-health.service \
    /usr/lib/systemd/system/boot-complete.target.requires/punar-update-health.service

# Podman is a rootless CLI by default. Distribution packages sometimes enable
# a global user API socket plus periodic lifecycle jobs during installation;
# leave those opt-in so an idle developer session pays no daemon or timer cost.
systemctl --global disable \
    podman-auto-update.service podman-auto-update.timer \
    podman-clean-transient.service podman-restart.service \
    podman.service podman.socket >/dev/null 2>&1 || true

# Pre-warm the vendored font cache so the first onboarding/session surface
# does not pay the scan. Fontconfig can recover at runtime if this fails.
fc-cache --system-only -f \
    || echo "warning: fc-cache failed; runtime scan will cover it" >&2
