[Unit]
Description=Materialize Punar local identity from shared state
Documentation=file:/usr/share/doc/punar/onboarding-flow.md
Requires=punard.service
After=local-fs.target systemd-tmpfiles-setup.service punard.service
Before=systemd-user-sessions.service greetd.service systemd-userdbd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/punar-onboardd materialize
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# Recovery may remove an interrupted staged home. /home is therefore the sole
# persistent identity subtree writable by this short-lived root service.
ReadWritePaths=-/run/userdb -/run/punar -/run/punar-first-login /var/lib/punar /home
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
